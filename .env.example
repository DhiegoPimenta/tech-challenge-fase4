# Copie para .env (não versionado) e preencha. Sem as chaves o app funciona em modo offline/demonstração.

# Azure AI Speech (Speech to Text)
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=brazilsouth
AZURE_SPEECH_LANGUAGE=pt-BR

# Azure AI Language (antigo Text Analytics)
AZURE_LANGUAGE_ENDPOINT=https://<seu-recurso>.cognitiveservices.azure.com/
AZURE_LANGUAGE_KEY=

# Opcional: webhook (Teams / Slack / Logic App) para disparar alertas à equipe médica
ALERT_WEBHOOK_URL=

# Onde ficam os pesos YOLOv8 (baixados automaticamente na 1ª execução se não existirem)
MODELS_DIR=models
